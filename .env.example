# Run python3 scripts/configure_local.py to generate unique development secrets.
ENVIRONMENT=development
JWT_SECRET=replace-with-a-unique-secret-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-unique-database-password
DATABASE_URL=postgresql+psycopg://fitness:replace-with-a-unique-database-password@postgres:5432/fitness
# Production: use rediss://:<access-key>@<host>:10000/0; CA and hostname verification are required.
# Azure Managed Redis must use nonclustered mode and access-key authentication for Celery.
REDIS_URL=redis://redis:6379/0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_WEB_URL=http://localhost:5173
SEED_ADMIN_PASSWORD=
SEED_CLIENT_PASSWORD=
# local is for development; production supports s3 or azure.
STORAGE_PROVIDER=local
# Azure uses the attached managed identity; no storage keys or SAS tokens are needed.
# Example account URL: https://<account-name>.blob.core.windows.net
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=
# Set the client ID for a user-assigned identity; leave empty for a system-assigned identity.
AZURE_MANAGED_IDENTITY_CLIENT_ID=
MEDIA_ROOT=./private-media
VIDEO_MAX_UPLOAD_MB=100
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=fitness-private
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
MINIO_ROOT_USER=fitness-storage
MINIO_ROOT_PASSWORD=replace-with-a-unique-storage-password
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
# SMTP connections require STARTTLS with certificate verification.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=syrefitness6@gmail.com
VITE_API_URL=/api/v1
VITE_DEMO_MODE=true
