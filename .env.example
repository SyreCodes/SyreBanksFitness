STORAGE_PROVIDER=local
MEDIA_ROOT=./private-media
VIDEO_MAX_UPLOAD_MB=100
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=fitness-private
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
MINIO_ROOT_USER=fitness-storage
MINIO_ROOT_PASSWORD=replace-with-a-unique-storage-password
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
